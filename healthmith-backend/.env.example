# healthmith-backend/.env로 복사한다. 실제 값은 커밋하지 않는다.
# bootRun은 현재 폴더의 .env를 Spring properties 형식으로 읽는다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 기본 R2DBC 저장 경로. Supabase 마이그레이션과 제한된 앱 역할을 별도로 준비한다.
# DB 소유자 비밀번호를 R2DBC_PASSWORD에 재사용하지 않는다.
# R2DBC_URL=r2dbc:postgresql://localhost:5432/postgres
# R2DBC_USERNAME=healthmith_app
# R2DBC_PASSWORD=
# R2DBC_POOL_MAX_SIZE=5
# Supabase IPv4 세션 풀러에서는 사용자 이름이 healthmith_app.<PROJECT_REF>다.
# 원격 연결 URL은 sslMode=verify-full&sslRootCert=<URL 인코딩한 CA 파일 경로>를 포함한다.

# 관리자 DB 자격 증명과 Google Secret은 .env.admin.example을 참고해 .env.admin에 별도 보관한다.

# 생성 worker. 로그인·사전조사에는 불필요하다. 아래 전체 설정과 검토한 DB 정책을 준비한 뒤 켠다.
GENERATION_WORKER_ENABLED=false
# GENERATION_WORKER_GEMINI_KEY=
# GENERATION_WORKER_MODEL=
# 시간은 Spring Duration 형식(예: 500ms, 10s). 실제 운영값을 정해 입력한다.
# GENERATION_WORKER_POLL_INTERVAL=
# GENERATION_WORKER_REQUEST_TIMEOUT=
# GENERATION_WORKER_QUEUED_TIMEOUT=
# GENERATION_WORKER_LEASE_SECONDS=
# GENERATION_WORKER_MAX_OUTPUT_TOKENS=
# REQUEST_TIMEOUT은 LEASE_SECONDS보다 짧고, POLL_INTERVAL도 lease보다 짧아야 한다.
# 일반 API 계정의 비밀번호를 재사용하지 않는 별도 최소 권한 로그인이다.
# WORKER_R2DBC_URL=
# WORKER_R2DBC_USERNAME=
# WORKER_R2DBC_PASSWORD=
# PostgREST 모드에서만 필요하다. R2DBC 모드에는 사용하지 않는다.
# GENERATION_WORKER_SERVICE_KEY=
# Spring API는 Google Secret 대신 Supabase가 발급한 사용자 JWT를 검증한다.
