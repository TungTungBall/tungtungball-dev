# healthmith-backend/.env로 복사한다. 실제 값은 커밋하지 않는다.
# bootRun은 현재 폴더의 .env를 Spring properties 형식으로 읽는다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 기본 R2DBC 저장 경로. Supabase 마이그레이션과 제한된 앱 역할을 별도로 준비한다.
# DB 소유자 비밀번호를 R2DBC_PASSWORD에 재사용하지 않는다.
# R2DBC_URL=r2dbc:postgresql://localhost:5432/postgres
# R2DBC_USERNAME=healthmith_app
# R2DBC_PASSWORD=

# 로컬 보관용: Google OAuth Secret은 Supabase Auth의 Google 공급자에 등록한다.
# Spring API는 Google Secret 대신 Supabase가 발급한 사용자 JWT를 검증한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase 프로젝트를 만들 때 지정한 DB 비밀번호의 로컬 보관용.
# 이 보관값으로 앱이 DB에 직접 접속하지 않는다.
SUPABASE_DB_PASSWORD=
