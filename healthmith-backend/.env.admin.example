# 관리 도구용 .env.admin으로 복사한다. 앱 서버가 읽는 .env와 분리하고 실제 값은 커밋하지 않는다.
# Supabase Connect 화면의 Session pooler 연결 정보와 프로젝트 생성 시 지정한 DB 비밀번호.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_ADMIN_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSL_ROOT_CERT=.local/supabase-ca.crt

# 로컬 보관용. 실제 OAuth Secret은 Supabase Auth의 Google 공급자에 등록한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
